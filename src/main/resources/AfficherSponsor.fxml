<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="638.0" prefWidth="812.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="esprit.tn.controllers.AfficherSponsor">

    <!-- Sidebar -->
    <VBox layoutX="0.0" layoutY="0.0" prefHeight="638.0" prefWidth="250.0" style="-fx-background-color: #1E3A5F; -fx-padding: 20px;">

        <!-- Logo -->
        <ImageView fitHeight="192.0" fitWidth="198.0" style="-fx-margin-bottom: 20px;">
            <image>
                <Image url="@images/logo.png" />
            </image>
        </ImageView>

        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn" text="🏠 Acceuil">
            <VBox.margin>
                <Insets top="40.0" />
            </VBox.margin></Button>
        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn" text="📅 Voir Événements" />
        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn" text="➕ Ajouter Événement" />
        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn selected-btn" text="➕ Ajouter Sponsor" />
        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn" text="⚙️ Paramètres" />

    </VBox>

    <!-- Contenu principal -->
    <AnchorPane layoutX="270.0" layoutY="50.0">

        <Text layoutX="20.0" layoutY="20.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Liste des Sponsors" />

        <!-- Liste des sponsors -->
        <ListView fx:id="sponsorListView" layoutX="20.0" layoutY="60.0" prefHeight="500.0" prefWidth="500.0" />

    </AnchorPane>

</AnchorPane>
