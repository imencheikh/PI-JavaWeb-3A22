<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="637.0" prefWidth="828.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="esprit.tn.controllers.HistoriqueController">

    <!-- Sidebar -->
    <VBox layoutX="-5.0" layoutY="0.0" prefHeight="638.0" prefWidth="255.0" style="-fx-background-color: #1E3A5F; -fx-padding: 20px;">

        <!-- Logo -->
        <ImageView fitHeight="162.0" fitWidth="169.0">
            <image>
                <Image url="@images/logo.png" />
            </image>
        </ImageView>

        <Button prefHeight="40.0" prefWidth="200.0" styleClass="sidebar-btn" text="🏠 Acceuil">
            <VBox.margin>
                <Insets top="40.0" />
            </VBox.margin>
        </Button>

            

    </VBox>

    <!-- Contenu principal -->
    <AnchorPane layoutX="270.0" layoutY="20.0">
        <Text layoutX="20.0" layoutY="20.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Historique des evenements" />

        <TableView fx:id="historiqueTable" layoutY="38.0" prefHeight="468.0" prefWidth="542.0">
            <columns>
                <TableColumn fx:id="colAction" prefWidth="120.0" text="Action" />
                <TableColumn fx:id="colDate" prefWidth="171.20001220703125" text="Date" />

                <TableColumn fx:id="colDetails" minWidth="0.0" prefWidth="250.39996337890625" text="Détails" />
            </columns>
        </TableView>


    </AnchorPane>

</AnchorPane>
